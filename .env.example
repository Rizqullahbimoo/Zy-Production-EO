APP_NAME=ZY-Production
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zy_production
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Default mailer 'brevo' pakai Brevo HTTP API (bukan SMTP) — Railway
# memblokir outbound port SMTP (587), jadi kirim email lewat SMTP gagal
# di production. Isi BREVO_API_KEY dari Brevo dashboard > API Keys
# (bukan SMTP Keys).
MAIL_MAILER=brevo
BREVO_API_KEY=

# Mailer 'smtp' disimpan sebagai fallback/opsi untuk development lokal
# (ganti MAIL_MAILER=smtp di atas kalau mau pakai ini).
MAIL_ENCRYPTION=tls
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_TIMEOUT=10
MAIL_USERNAME=
MAIL_PASSWORD=

# Shared oleh semua mailer (tidak spesifik ke smtp/brevo)
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"

# ── MIDTRANS PAYMENT GATEWAY ──────────────────────────────────────────────────
# Isi dengan credential dari https://dashboard.midtrans.com
# Gunakan Sandbox untuk development, Production untuk live
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
VITE_MIDTRANS_CLIENT_KEY="${MIDTRANS_CLIENT_KEY}"
VITE_MIDTRANS_IS_PRODUCTION="${MIDTRANS_IS_PRODUCTION}"
